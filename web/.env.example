ENVIRONMENT_NAME="baby-prod"
# Matches docker-compose.dev.yml; run `npm run dev` and it starts/waits for this automatically.
DATABASE_URL="postgresql://babyly:babyly-dev@localhost:55432/babyly_dev?schema=public"
APP_BASE_URL="http://localhost:3000"
ACCESS_CODE="vervang-dit-met-jouw-geheime-code"
# Minimaal 32 tekens
SESSION_SECRET="vervang-dit-met-een-lange-willekeurige-geheime-waarde"
MAGIC_LINK_TTL_MINUTES="1440"
EMAIL_DELIVERY_MODE="console"
# Exact 2 e-mails, komma-gescheiden
ADMIN_EMAILS="ouder1@example.com,ouder2@example.com"
PRIVACY_CONTACT_EMAIL="privacy@example.com"
EMAIL_TEST_RECIPIENT="jouw-e-mailadres@example.com"
# Temporary local diagnosis only; never enable this in production.
CSRF_BYPASS_LOCAL_ONLY="false"
