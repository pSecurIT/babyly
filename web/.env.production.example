ENVIRONMENT_NAME="baby-production"
DATABASE_URL="postgresql://babyly:CHANGE_THIS@db:5432/babyly?schema=public"
APP_BASE_URL="https://baby.example.invalid"
ACCESS_CODE="CHANGE_THIS_LONG_RANDOM_ACCESS_CODE"
SESSION_SECRET="CHANGE_THIS_TO_AT_LEAST_32_RANDOM_CHARACTERS"
MAGIC_LINK_TTL_MINUTES="15"
EMAIL_DELIVERY_MODE="provider"
ADMIN_EMAILS="privacy@example.invalid,admin2@example.invalid"
PRIVACY_CONTACT_EMAIL="privacy@example.invalid"

# Used by the database service in docker-compose.production.yml.
POSTGRES_DB="babyly"
POSTGRES_USER="babyly"
POSTGRES_PASSWORD="CHANGE_THIS_DATABASE_PASSWORD"

# Required for Resend provider delivery.
RESEND_API_KEY="CHANGE_THIS_RESEND_API_KEY"
EMAIL_FROM="Babyly <baby@example.invalid>"

# S3-compatible off-site backup configuration for deploy/backup.sh.
BACKUP_S3_ENDPOINT="https://ams3.digitaloceanspaces.com"
BACKUP_S3_BUCKET="CHANGE_THIS_PRIVATE_BUCKET"
BACKUP_S3_REGION="ams3"
BACKUP_S3_ACCESS_KEY="CHANGE_THIS_BACKUP_ACCESS_KEY"
BACKUP_S3_SECRET_KEY="CHANGE_THIS_BACKUP_SECRET_KEY"
BACKUP_ENCRYPTION_PASSWORD_FILE="/etc/babyly/backup-encryption-password"
