// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  boy
  girl
}

enum TokenPurpose {
  guest_login
  admin_login
}

model AccessCode {
  id        String   @id
  codeHash  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_codes")
}

model Participant {
  id              String      @id @default(cuid())
  name            String?
  email           String      @unique
  emailVerifiedAt DateTime?
  reminderSentAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  prediction      Prediction?
  addressCard     AddressCard?
  magicTokens     MagicLinkToken[]

  @@map("participants")
}

model Prediction {
  id               String      @id @default(cuid())
  participantId    String      @unique
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  predictedName    String      @default("")
  gender           Gender
  weightGrams      Int
  heightCm         Int
  predictedBirthAt DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([participantId])
  @@map("predictions")
}

model AddressCard {
  id            String      @id @default(cuid())
  participantId String      @unique
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  recipientName String
  street        String
  houseNumber   String
  postalCode    String
  city          String
  country       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([participantId])
  @@map("address_cards")
}

model MagicLinkToken {
  id         String       @id @default(cuid())
  email      String
  tokenHash  String
  purpose    TokenPurpose
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([email, purpose, expiresAt])
  @@index([tokenHash])
  @@map("magic_link_tokens")
}

model AdminAllowlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("admin_allowlist")
}

model EmailTemplate {
  key       String   @id
  subject   String
  html      String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model CustomEmail {
  id        String            @id @default(cuid())
  name      String
  subject   String
  html      String
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sends     CustomEmailSend[]

  @@map("custom_emails")
}

model CustomEmailSend {
  id            String                 @id @default(cuid())
  customEmailId String
  customEmail   CustomEmail            @relation(fields: [customEmailId], references: [id], onDelete: Cascade)
  subject       String
  sentBy        String
  sentAt        DateTime               @default(now())
  recipients    CustomEmailRecipient[]

  @@index([customEmailId])
  @@map("custom_email_sends")
}

model CustomEmailRecipient {
  id        String          @id @default(cuid())
  sendId    String
  send      CustomEmailSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  // sent | failed
  status    String
  createdAt DateTime        @default(now())

  @@unique([sendId, email])
  @@map("custom_email_recipients")
}
